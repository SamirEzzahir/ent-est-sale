# ============================================================
# ENT EST Sale - Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# ============================================================

# Cassandra
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=ent

# Public browser entry point (set this to your server IP or domain in deployment)
PUBLIC_BASE_URL=http://localhost

# MinIO
MINIO_HOST=minio:9000
MINIO_PUBLIC_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=course-files
MINIO_SECURE=false

# MinIO service root credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123

# Keycloak service
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_PORT=8080
KEYCLOAK_REALM=ent-est-sale
KEYCLOAK_CLIENT_ID=ent-backend
KEYCLOAK_CLIENT_SECRET=ent-backend-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak Admin API access
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
# KEYCLOAK_ADMIN_CLIENT_SECRET=
