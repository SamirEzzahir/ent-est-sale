# ============================================================
# ENT EST Sale - Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# ============================================================

# ============================================================
# 🔧 DEPLOYMENT CONFIGURATION - Change this for server deployment
# ============================================================
# For local development: ${SERVER_HOST}
# For server deployment: your.server.ip (e.g., 192.168.1.100)
SERVER_HOST=localhost

# Public browser entry point (automatically set from SERVER_HOST)
PUBLIC_BASE_URL=http://${SERVER_HOST}:80

# ============================================================
# Cassandra
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=ent

# MinIO
MINIO_HOST=minio:9000
MINIO_PUBLIC_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=course-files
MINIO_SECURE=false

# MinIO service root credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123

# Keycloak service
# Internal service communication (docker network)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_PORT=8080
# Public URL for browser (uses SERVER_HOST)
KEYCLOAK_PUBLIC_URL=http://${SERVER_HOST}:8080
KEYCLOAK_REALM=ent-est-sale
KEYCLOAK_CLIENT_ID=ent-backend
# Leave empty for the public browser client used by the current Compose MVP.
# Set only if you intentionally switch the Keycloak client to confidential mode.
KEYCLOAK_CLIENT_SECRET=ent-backend-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak Admin API access
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
# KEYCLOAK_ADMIN_CLIENT_SECRET=

# Frontend origins allowed to call backend APIs directly in dev/debug mode.
# The gateway entrypoint is already inferred from PUBLIC_BASE_URL.
CORS_ALLOWED_ORIGINS=http://${SERVER_HOST},http://${SERVER_HOST}:5173,http://127.0.0.1:5173

# AI assistant / Ollama
CORE_AUTH_URL=http://core-auth:8001/api/auth
DOWNLOAD_SERVICE_URL=http://download-service:8003/api/download
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama2
AI_ASSISTANT_FALLBACK=true

# ============================================================
# FRONTEND CONFIGURATION (VITE environment variables)
# ============================================================
# API endpoints - All use the same gateway
# For local dev: leave empty (will use relative /api)
# For server deployment: set to http://SERVER_HOST
VITE_API_BASE_URL=/api

# Keycloak frontend access
VITE_KEYCLOAK_URL=http://${SERVER_HOST}:8080
VITE_KEYCLOAK_REALM=ent-est-sale
VITE_KEYCLOAK_CLIENT_ID=ent-frontend

# Optional: Override individual service URLs (usually not needed)
# VITE_UPLOAD_API_URL=
# VITE_DOWNLOAD_API_URL=
# VITE_AUTH_API_URL=
# VITE_COURSES_API_URL=
# VITE_ASSIGNMENTS_API_URL=
# VITE_GRADES_API_URL=
# VITE_NOTIFICATIONS_API_URL=
# VITE_SCHEDULE_API_URL=
# VITE_AI_API_URL=
