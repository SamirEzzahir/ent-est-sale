# Keycloak base URL (no trailing slash)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ent-sale
KEYCLOAK_CLIENT_ID=ent-frontend
# Leave empty for public client (direct access grant)
KEYCLOAK_CLIENT_SECRET=

# Expected JWT audience (Keycloak often uses "account" for realm roles token)
KEYCLOAK_AUDIENCE=account
# Set false if token validation fails on audience mismatch
KEYCLOAK_VERIFY_AUD=false

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Registration (Keycloak confidential client + service account with manage-users)
KEYCLOAK_ADMIN_CLIENT_ID=ent-registration
KEYCLOAK_ADMIN_CLIENT_SECRET=ent-registration-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_REALM=master
DEFAULT_REGISTER_ROLE=STUDENT
